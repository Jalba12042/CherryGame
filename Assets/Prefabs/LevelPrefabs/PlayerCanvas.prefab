  m_Name: 
  m_EditorClassIdentifier: 
  loadingPanel: {fileID: 853841316640057920}
  loadingBarFill: {fileID: 0}
  pressAButtonPrompt: {fileID: 1892135577890990912}
  tipsText: {fileID: 8618094122311185406}
  tipInterval: 5
  levelTitleText: {fileID: 1881583604443073135}
  xboxTips:
  - Alien chasing you? Dash (X) toward a friend. The alien will get them instead!
  - Zombies? Keep moving! Sabotage friends by grabbing (RT) and holding them.
  - Meteor incoming! Hold a cherry if your basket isn't full.
  - Dizzy? Your controls are reversed. Move the opposite way!
  - Protein makes you big but slow. Jump (A) to shake the ground!
  - Got the toy gun? Press RT to shoot.
  - Coffee makes you crazy fast. You won't be able to stop!
  - Tap RT to pick up, use items, drop things, or grab players.
  - Hold RT to aim. It's safer to drop items close to your basket than throw them.
  - 'Dash (X) for a speed boost! Warning: may cause fart noises and soiled underwear.'
  - Losing? Mad? Press Y to scream. Let it all out.
  - Watch out for park sprinklers or you'll drop your cherry! Jump (A) over them.
  - Raining? Hurry up! Others can steal from your basket.
  - Use the Magnet to collect everything fast, just don't get electrocuted!
  psTips:
  - Alien chasing you? Dash (Square) toward a friend. The alien will get them instead!
  - Zombies? Keep moving! Sabotage friends by grabbing (R2) and holding them.
  - Meteor incoming! Hold a cherry if your basket isn't full.
  - Dizzy? Your controls are reversed. Move the opposite way!
  - Protein makes you big but slow. Jump (Cross) to shake the ground!
  - Got the toy gun? Press R2 to shoot.
  - Coffee makes you crazy fast. You won't be able to stop!
  - Tap R2 to pick up, use items, drop things, or grab players.
  - Hold R2 to aim. It's safer to drop items close to your basket than throw them.
  - 'Dash (Square) for a speed boost! Warning: may cause fart noises and soiled underwear.'
  - Losing? Mad? Press Triangle to scream. Let it all out.
  - Watch out for park sprinklers or you'll drop your cherry! Jump (Cross) over them.
  - Raining? Hurry up! Others can steal from your basket.
  - Use the Magnet to collect everything fast, just don't get electrocuted!
  kbTips:
  - Alien chasing you? Dash (Shift) toward a friend. The alien will get them instead!
  - Zombies? Keep moving! Sabotage friends by grabbing (E) and holding them. (Mash
    F to escape!)
  - Meteor incoming! Hold a cherry if your basket isn't full.
  - Dizzy? Your controls are reversed. Move the opposite way!
  - Protein makes you big but slow. Jump (Space) to shake the ground!
  - Got the toy gun? Press E to shoot.
  - Coffee makes you crazy fast. You won't be able to stop!
  - Tap E to pick up, use items, drop things, or grab players.
  - Hold E to aim. It's safer to drop items close to your basket than throw them.
  - 'Dash (Shift) for a speed boost! Warning: may cause fart noises and soiled underwear.'
  - Losing? Mad? Press R to scream. Let it all out.
  - Watch out for park sprinklers or you'll drop your cherry! Jump (Space) over them.
  - Raining? Hurry up! Others can steal from your basket.
  - Use the Magnet to collect everything fast, just don't get electrocuted!
